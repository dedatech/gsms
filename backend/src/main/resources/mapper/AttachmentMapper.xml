<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gsms.gsms.repository.AttachmentMapper">

    <!-- 结果映射 -->
    <resultMap id="AttachmentResultMap" type="com.gsms.gsms.model.entity.Attachment">
        <id column="id" property="id"/>
        <result column="file_name" property="fileName"/>
        <result column="display_name" property="displayName"/>
        <result column="file_path" property="filePath"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_type" property="fileType"/>
        <result column="mime_type" property="mimeType"/>
        <result column="storage_type" property="storageType"/>
        <result column="target_type" property="targetType"/>
        <result column="target_id" property="targetId"/>
        <result column="uploader_id" property="uploaderId"/>
        <result column="uploader_name" property="uploaderName"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 查询所有字段 -->
    <sql id="selectAllFields">
        id, file_name, display_name, file_path, file_size, file_type, mime_type, storage_type,
        target_type, target_id, uploader_id, uploader_name, create_time, update_time, is_deleted
    </sql>

    <!-- 根据关联对象查询附件列表 -->
    <select id="selectByTarget" resultMap="AttachmentResultMap">
        SELECT <include refid="selectAllFields"/>
        FROM gsms_attachment
        WHERE target_type = #{targetType}
          AND target_id = #{targetId}
          AND is_deleted = 0
        ORDER BY create_time DESC
    </select>

    <!-- 根据关联对象查询附件数量 -->
    <select id="countByTarget" resultType="int">
        SELECT COUNT(*)
        FROM gsms_attachment
        WHERE target_type = #{targetType}
          AND target_id = #{targetId}
          AND is_deleted = 0
    </select>

    <!-- 逻辑删除附件 -->
    <update id="logicalDelete">
        UPDATE gsms_attachment
        SET is_deleted = 1, update_time = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>
</mapper>
